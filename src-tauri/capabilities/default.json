{
  "identifier": "default",
  "description": "Default permissions for SSHSpan",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:event:default",
    "core:tray:default",
    "core:path:default",
    "core:menu:default",

    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",

    "shell:default",
    "shell:allow-execute",

    "process:default",
    "process:allow-exit",
    "process:allow-restart",

    "os:default",
    "os:allow-platform",
    "os:allow-family",
    "os:allow-arch",
    "os:allow-hostname",

    "notification:default",
    "notification:allow-notify",

    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",

    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",

    "updater:default"
  ]
}
