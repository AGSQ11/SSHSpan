{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHSpan",
  "version": "1.3.3",
  "identifier": "org.sshspan.app",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "SSHSpan",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://tauri.localhost https://*.bitwarden.com https://*.bitwarden.eu"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "assets/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "appimage": {},
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-common"
        ]
      }
    }
  }
}
