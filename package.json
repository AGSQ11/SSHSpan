{
  "name": "sshspan",
  "productName": "SSHSpan",
  "version": "1.7.2-1",
  "description": "Cross-platform SSH key manager and SSH client. Encrypted local vault, categories, Bitwarden sync, deploy, and an embedded PuTTY-grade terminal. Rust/Tauri core.",
  "author": {
    "name": "AGSQ11",
    "email": "agsq11@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/AGSQ11/SSHSpan",
  "repository": {
    "type": "git",
    "url": "https://github.com/AGSQ11/SSHSpan.git"
  },
  "bugs": {
    "url": "https://github.com/AGSQ11/SSHSpan/issues"
  },
  "keywords": [
    "ssh",
    "keys",
    "ssh-keygen",
    "rsa",
    "ed25519",
    "ecdsa",
    "tauri",
    "security",
    "sqlite",
    "bitwarden"
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "dist:win": "tauri build --target x86_64-pc-windows-msvc",
    "dist:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "icon": "node scripts/make-icon.js",
    "icon:sidebar": "node scripts/make-sidebar-icon.js",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "linux"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2"
  }
}
